generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../storage/threads_studio.sqlite"
}

model Project {
  id           String      @id @default(uuid())
  title        String
  threadsUrl   String
  status       String      @default("draft") // draft, fetching, fetched, rendering, completed, error
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  
  post         Post?
  comments     Comment[]
  scenes       Scene[]
  renderJobs   RenderJob[]
  videoConfig  String?     // JSON serialized VideoConfig
  channelMapping ProjectChannelMapping?
}

model Post {
  id           String   @id
  projectId    String   @unique
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url          String
  username     String
  displayName  String
  avatar       String
  content      String
  mediaUrls    String   // JSON array
  timestamp    String
  likes        Int      @default(0)
  repliesCount Int      @default(0)
  verified     Boolean  @default(false)
}

model Comment {
  id          String   @id
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  username    String
  displayName String
  avatar      String
  content     String
  likes       Int      @default(0)
  timestamp   String
  selected    Boolean  @default(true)
  order       Int      @default(0)
  mediaUrl    String?
}

model Scene {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order     Int
  type      String   // hook, post, comment, outro
  title     String
  text      String
  voice     String
  duration  Float?
  selected  Boolean  @default(true)
}

model RenderJob {
  id              String    @id @default(uuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status          String    @default("queued") // idle, queued, rendering, completed, failed
  progress        Int       @default(0)
  currentStep     String
  stepDetails     String?
  logs            String    // JSON array
  outputVideoPath String?
  outputVideoUrl  String?
  thumbnailUrl    String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  error           String?
}

model Setting {
  key   String @id
  value String
}

model YouTubeAccount {
  id              String           @id
  channelId       String           @unique
  channelTitle    String
  channelHandle   String?
  avatarUrl       String?
  subscriberCount Int              @default(0)
  videoCount      Int              @default(0)
  accessToken     String
  refreshToken    String?
  tokenExpiry     String?
  isActive        Boolean          @default(true)
  internalName    String?
  timezone        String           @default("Asia/Ho_Chi_Minh")
  dailyUploadLimit Int             @default(10)
  isDefault       Boolean          @default(false)
  quotaUsedToday  Int              @default(0)
  quotaResetAt    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  publishes       YouTubePublish[]
  reports         YouTubeAnalyticsReport[]
  aiReports       AIContentReport[]
  experiments     ContentExperiment[]
  projectMappings ProjectChannelMapping[]
}

model ProjectChannelMapping {
  projectId       String         @id
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  accountId       String
  account         YouTubeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  assignedAt      DateTime       @default(now())
}

model YouTubePublish {
  id             String                 @id
  accountId      String?
  account        YouTubeAccount?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
  channelTitle   String?
  projectId      String?
  projectTitle   String?
  videoPath      String
  videoUrl       String?
  title          String
  description    String?
  tags           String?                // JSON array
  categoryId     String                 @default("22")
  privacyStatus  String                 @default("private")
  publishAt      String?
  thumbnailPath  String?
  thumbnailUrl   String?
  youtubeVideoId String?
  status         String                 @default("draft")
  uploadProgress Int                    @default(0)
  errorMessage   String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  publishedAt    DateTime?
  analytics      YouTubeVideoAnalytics?
}

model YouTubeAnalyticsReport {
  id             String         @id
  accountId      String
  account        YouTubeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  periodDays     Int
  startDate      String
  endDate        String
  summaryMetrics String         // JSON
  dailyData      String         // JSON
  topVideos      String         // JSON
  source         String         @default("live_youtube_api")
  syncedAt       DateTime       @default(now())
}

model YouTubeVideoAnalytics {
  id                         String          @id
  youtubeVideoId             String          @unique
  publishId                  String?         @unique
  publish                    YouTubePublish? @relation(fields: [publishId], references: [id], onDelete: SetNull)
  title                      String?
  thumbnailUrl               String?
  views                      Int             @default(0)
  estimatedMinutesWatched    Float           @default(0)
  averageViewDurationSeconds Float           @default(0)
  averageViewPercentage      Float           @default(0)
  likes                      Int             @default(0)
  comments                   Int             @default(0)
  shares                     Int             @default(0)
  subscribersGained          Int             @default(0)
  retentionRate              Float           @default(0)
  syncedAt                   DateTime        @default(now())
}

model AIContentReport {
  id                  String         @id
  accountId           String
  account             YouTubeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  channelTitle        String
  reportTitle         String
  summaryNarrative    String
  performanceInsights String         // JSON
  contentIdeas        String         // JSON
  titleSuggestions    String         // JSON
  thumbnailConcepts   String         // JSON
  actionPlan          String         // JSON
  markdownReport      String
  aiModelUsed         String
  source              String         @default("smart_heuristic")
  status              String         @default("active")
  createdAt           DateTime       @default(now())
}

model ContentExperiment {
  id                String          @id
  title             String
  videoId           String
  videoTitle        String
  videoThumbnailUrl String?
  accountId         String?
  account           YouTubeAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  channelTitle      String?
  experimentType    String          @default("title") // title, thumbnail, title_and_thumbnail
  testMode          String          @default("sequential") // sequential, youtube_native
  status            String          @default("draft") // draft, running, completed, cancelled
  currentVariantId  String?
  winnerVariantId   String?
  winnerDeclaredAt  DateTime?
  hypothesis        String?
  conclusion        String?
  variants          String          // JSON array of ExperimentVariant
  targetMetric      String          @default("watch_time_per_day")
  upliftPercent     Float           @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}
