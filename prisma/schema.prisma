generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:../storage/threads_studio.sqlite"
}

model Project {
  id           String      @id @default(uuid())
  title        String
  threadsUrl   String
  status       String      @default("draft") // draft, fetching, fetched, rendering, completed, error
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  
  post         Post?
  comments     Comment[]
  scenes       Scene[]
  renderJobs   RenderJob[]
  videoConfig  String?     // JSON serialized VideoConfig
  channelMapping ProjectChannelMapping?
}

model Post {
  id           String   @id
  projectId    String   @unique
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url          String
  username     String
  displayName  String
  avatar       String
  content      String
  mediaUrls    String   // JSON array
  timestamp    String
  likes        Int      @default(0)
  repliesCount Int      @default(0)
  verified     Boolean  @default(false)
}

model Comment {
  id          String   @id
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  username    String
  displayName String
  avatar      String
  content     String
  likes       Int      @default(0)
  timestamp   String
  selected    Boolean  @default(true)
  order       Int      @default(0)
  mediaUrl    String?
}

model Scene {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order     Int
  type      String   // hook, post, comment, outro
  title     String
  text      String
  voice     String
  duration  Float?
  selected  Boolean  @default(true)
}

model RenderJob {
  id              String    @id @default(uuid())
  projectId       String
  project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status          String    @default("queued") // idle, queued, rendering, completed, failed
  progress        Int       @default(0)
  currentStep     String
  stepDetails     String?
  logs            String    // JSON array
  outputVideoPath String?
  outputVideoUrl  String?
  thumbnailUrl    String?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  error           String?
}

model Setting {
  key   String @id
  value String
}

model YouTubeAccount {
  id              String           @id
  channelId       String           @unique
  channelTitle    String
  channelHandle   String?
  avatarUrl       String?
  subscriberCount Int              @default(0)
  videoCount      Int              @default(0)
  accessToken     String
  refreshToken    String?
  tokenExpiry     String?
  isActive        Boolean          @default(true)
  internalName    String?
  timezone        String           @default("Asia/Ho_Chi_Minh")
  dailyUploadLimit Int             @default(10)
  isDefault       Boolean          @default(false)
  quotaUsedToday  Int              @default(0)
  quotaResetAt    String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  publishes       YouTubePublish[]
  reports         YouTubeAnalyticsReport[]
  aiReports       AIContentReport[]
  experiments     ContentExperiment[]
  projectMappings ProjectChannelMapping[]
}

model ProjectChannelMapping {
  projectId       String         @id
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  accountId       String
  account         YouTubeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  assignedAt      DateTime       @default(now())
}

model YouTubePublish {
  id             String                 @id
  accountId      String?
  account        YouTubeAccount?        @relation(fields: [accountId], references: [id], onDelete: SetNull)
  channelTitle   String?
  projectId      String?
  projectTitle   String?
  videoPath      String
  videoUrl       String?
  title          String
  description    String?
  tags           String?                // JSON array
  categoryId     String                 @default("22")
  privacyStatus  String                 @default("private")
  publishAt      String?
  thumbnailPath  String?
  thumbnailUrl   String?
  youtubeVideoId String?
  status         String                 @default("draft")
  uploadProgress Int                    @default(0)
  errorMessage   String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  publishedAt    DateTime?
  analytics      YouTubeVideoAnalytics?
}

model YouTubeAnalyticsReport {
  id             String         @id
  accountId      String
  account        YouTubeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  periodDays     Int
  startDate      String
  endDate        String
  summaryMetrics String         // JSON
  dailyData      String         // JSON
  topVideos      String         // JSON
  source         String         @default("live_youtube_api")
  syncedAt       DateTime       @default(now())
}

model YouTubeVideoAnalytics {
  id                         String          @id
  youtubeVideoId             String          @unique
  publishId                  String?         @unique
  publish                    YouTubePublish? @relation(fields: [publishId], references: [id], onDelete: SetNull)
  title                      String?
  thumbnailUrl               String?
  views                      Int             @default(0)
  estimatedMinutesWatched    Float           @default(0)
  averageViewDurationSeconds Float           @default(0)
  averageViewPercentage      Float           @default(0)
  likes                      Int             @default(0)
  comments                   Int             @default(0)
  shares                     Int             @default(0)
  subscribersGained          Int             @default(0)
  retentionRate              Float           @default(0)
  syncedAt                   DateTime        @default(now())
}

model AIContentReport {
  id                  String         @id
  accountId           String
  account             YouTubeAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  channelTitle        String
  reportTitle         String
  summaryNarrative    String
  performanceInsights String         // JSON
  contentIdeas        String         // JSON
  titleSuggestions    String         // JSON
  thumbnailConcepts   String         // JSON
  actionPlan          String         // JSON
  markdownReport      String
  aiModelUsed         String
  source              String         @default("smart_heuristic")
  status              String         @default("active")
  createdAt           DateTime       @default(now())
}

model ContentExperiment {
  id                String          @id
  title             String
  videoId           String
  videoTitle        String
  videoThumbnailUrl String?
  accountId         String?
  account           YouTubeAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  channelTitle      String?
  experimentType    String          @default("title") // title, thumbnail, title_and_thumbnail
  testMode          String          @default("sequential") // sequential, youtube_native
  status            String          @default("draft") // draft, running, completed, cancelled
  currentVariantId  String?
  winnerVariantId   String?
  winnerDeclaredAt  DateTime?
  hypothesis        String?
  conclusion        String?
  variants          String          // JSON array of ExperimentVariant
  targetMetric      String          @default("watch_time_per_day")
  upliftPercent     Float           @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model SystemBackup {
  id               String   @id
  backupType       String   @default("manual") // manual, scheduled, pre-restore
  filename         String
  filePath         String
  fileSize         Int      @default(0)
  sha256Hash       String
  includesDatabase Boolean  @default(true)
  includesMedia    Boolean  @default(false)
  includesEnv      Boolean  @default(false)
  status           String   @default("completed") // completed, failed
  createdAt        DateTime @default(now())
  notes            String?
}

model BackupSchedule {
  id            String    @id @default("default")
  enabled       Boolean   @default(false)
  intervalHours Int       @default(24) // 6 - 168 hours
  keepCount     Int       @default(5)  // 1 - 50 backups
  includeMedia  Boolean   @default(false)
  includeEnv    Boolean   @default(false)
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  updatedAt     DateTime  @updatedAt
}

model Screenshot {
  id          String   @id
  projectId   String
  type        String
  refId       String
  filePath    String
  fileUrl     String
  theme       String   @default("light")
  aspectRatio String   @default("9:16")
  width       Int
  height      Int
  createdAt   DateTime @default(now())
}

model Audio {
  id        String   @id
  projectId String
  sceneId   String
  filePath  String
  fileUrl   String
  voice     String
  duration  Float
  text      String
  createdAt DateTime @default(now())
}

model BatchJob {
  id             String      @id
  title          String
  totalItems     Int         @default(0)
  completedItems Int         @default(0)
  failedItems    Int         @default(0)
  status         String      @default("queued")
  config         String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  items          BatchItem[]
}

model BatchItem {
  id             String    @id
  batchId        String
  batch          BatchJob  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  threadsUrl     String
  projectId      String?
  status         String    @default("pending")
  currentStep    String    @default("Chờ xử lý")
  progress       Int       @default(0)
  error          String?
  outputVideoUrl String?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?
}

model ThreadsAccount {
  id               String              @id
  username         String
  displayName      String?
  threadsUserId    String?
  avatarUrl        String?
  accessToken      String
  tokenType        String?             @default("bearer")
  expiresAt        DateTime?
  isActive         Boolean             @default(true)
  autoSync         Boolean             @default(true)
  syncIntervalMins Int                 @default(60)
  lastSyncedAt     DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  posts            ThreadsSyncedPost[]
}

model ThreadsSyncedPost {
  id             String          @id
  accountId      String?
  account        ThreadsAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  threadsId      String          @unique
  permalink      String
  authorUsername String
  authorName     String?
  authorAvatar   String?
  text           String
  mediaType      String?
  mediaUrl       String?
  likesCount     Int             @default(0)
  repliesCount   Int             @default(0)
  rawReplies     String?
  timestamp      String
  status         String?         @default("synced")
  projectId      String?
  createdAt      DateTime        @default(now())
}

model MonitoredSource {
  id                    String           @id
  username              String           @unique
  displayName           String?
  avatarUrl             String?
  bio                   String?
  followerCount         Int              @default(0)
  isActive              Boolean          @default(true)
  minLikesFilter        Int              @default(50)
  autoQueueToAutomation Boolean          @default(false)
  lastScrapedAt         DateTime?
  totalPostsDiscovered  Int              @default(0)
  sourceType            String           @default("PROFILE")
  target                String?
  searchMode            String           @default("TOP")
  mediaType             String           @default("ALL")
  limitPerSync          Int              @default(20)
  syncIntervalMinutes   Int              @default(60)
  fetchReplies          Boolean          @default(true)
  nextSyncAt            DateTime?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt
  discoveredPosts       DiscoveredPost[]
}

model DiscoveredPost {
  id             String           @id
  sourceId       String?
  source         MonitoredSource? @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  threadsId      String
  permalink      String           @unique
  authorUsername String
  authorName     String?
  authorAvatar   String?
  content        String
  mediaUrl       String?
  likesCount     Int              @default(0)
  repliesCount   Int              @default(0)
  rawComments    String?
  duplicateHash  String
  status         String?          @default("discovered")
  projectId      String?
  mediaType      String?          @default("TEXT")
  batchId        String?
  createdAt      DateTime         @default(now())
}

model DiscoverySyncLog {
  id              String   @id
  sourceId        String
  sourceTarget    String
  sourceType      String
  postsFound      Int      @default(0)
  newPostsSaved   Int      @default(0)
  queuedToBatch   Int      @default(0)
  status          String
  message         String?
  createdAt       DateTime @default(now())
}

model DiscoveryRateLimit {
  type        String   @id
  count24h    Int      @default(0)
  windowStart DateTime
}

model DesktopService {
  name        String   @id
  port        Int
  status      String   @default("stopped") // running, stopped
  pid         Int?
  lastStarted DateTime?
  updatedAt   DateTime @updatedAt
}

model DesktopConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ReleaseArtifact {
  id          String   @id
  version     String
  platform    String   @default("win32-x64")
  installer   String
  fileSize    Int
  sha256      String
  buildDate   DateTime @default(now())
}
